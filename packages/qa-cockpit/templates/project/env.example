# This machine's own values for QA Cockpit. Copy this file to .env, beside
# qa-cockpit.config.mjs, and set what differs here; .env is never committed.
# A variable set in the environment wins over the file.

# The port the QA copy of the app listens on, when the usual one is taken
# (by your own dev server, say). The config reads it: QA_APP_PORT.
# QA_APP_PORT=4401

# The cockpit's port, when another project's cockpit has the usual one.
# QA_COCKPIT_PORT=3151

# Who you are, in the lock and the cockpit («Claude», «ci», a person).
# QA_WHO=
