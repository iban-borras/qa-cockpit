{
  "name": "qa-cockpit",
  "version": "0.4.0",
  "description": "Vibe coding for integration tests: coding agents write and run multi-user Playwright suites, one browser per person; people watch every screen live in a cockpit and pin notes for the agent to fix.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iban-borras/qa-cockpit.git",
    "directory": "packages/qa-cockpit"
  },
  "homepage": "https://github.com/iban-borras/qa-cockpit#readme",
  "bugs": {
    "url": "https://github.com/iban-borras/qa-cockpit/issues"
  },
  "type": "module",
  "scripts": {
    "prepublishOnly": "node scripts/check-eol.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "qa-cockpit": "bin/qa-cockpit.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./fixtures": "./src/fixtures.mjs",
    "./playwright": "./src/playwright.mjs",
    "./reporter": "./src/reporter.mjs",
    "./worker": "./src/worker.mjs",
    "./compose": "./src/compose.mjs",
    "./process": "./src/process.mjs",
    "./sessions": "./src/sessions.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "assets",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "multi-user",
    "collaborative",
    "qa",
    "agents",
    "ai-agents",
    "vibe-coding",
    "claude-code",
    "codex",
    "dashboard"
  ]
}
