# This machine's own values for the example. Copy this file to .env, beside
# qa-cockpit.config.mjs, and set what differs here; .env is never committed.
# A variable set in the environment wins over the file.

# The port of the chat app's QA copy, when 4310 is taken here.
# QA_APP_PORT=4311

# The cockpit's port, when 3160 is taken here.
# QA_COCKPIT_PORT=3161
